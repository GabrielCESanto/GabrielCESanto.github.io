---
import '../styles/global.css';
import { perfil } from '../data/perfil';

interface Props {
  titulo?: string;
  descricao?: string;
}
const { titulo, descricao = perfil.frase } = Astro.props;
const tituloPagina = titulo ? `${titulo} · ${perfil.nomeCurto}` : `${perfil.nomeCurto} · ${perfil.cargo}`;
const atual = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/projetos', rotulo: 'Projetos' },
  { href: '/dashboards', rotulo: 'Dashboards' },
  { href: '/arquitetura', rotulo: 'Arquitetura' },
  { href: '/sobre', rotulo: 'Sobre' },
];
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloPagina}</title>
    <meta name="description" content={descricao} />
    <meta property="og:title" content={tituloPagina} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        const t = localStorage.getItem('tema');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="topo">
      <div class="wrap topo-in">
        <a href="/" class="marca" aria-label="Início">
          <span class="logo" aria-hidden="true">GC</span>
          <span class="marca-txt">{perfil.nomeCurto}</span>
        </a>
        <nav aria-label="Principal">
          {nav.map((i) => (
            <a href={i.href} aria-current={atual.startsWith(i.href) ? 'page' : undefined}>{i.rotulo}</a>
          ))}
          <button id="tema" class="tema" type="button" aria-label="Alternar tema claro/escuro" title="Alternar tema">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
          </button>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="rodape">
      <div class="wrap rodape-in">
        <p>© {new Date().getFullYear()} {perfil.nome}</p>
        <p class="links">
          <a href={perfil.links.github}>GitHub</a>
          <a href={perfil.links.linkedin}>LinkedIn</a>
          <a href={perfil.links.whatsapp}>WhatsApp</a>
        </p>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('tema')?.addEventListener('click', () => {
        const r = document.documentElement;
        const escuro = r.dataset.theme
          ? r.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        r.dataset.theme = escuro ? 'light' : 'dark';
        try { localStorage.setItem('tema', r.dataset.theme); } catch {}
        document.dispatchEvent(new Event('tema'));
      });
    </script>

    <script type="module" is:inline>
      // Converte blocos ```mermaid dos estudos de caso em diagramas. A biblioteca só é baixada
      // nas páginas que têm diagrama.
      // Markdown gera <pre><code class="language-mermaid">; páginas .astro usam <pre data-language="mermaid">.
      const blocos = [
        ...document.querySelectorAll('pre[data-language="mermaid"]'),
        ...[...document.querySelectorAll('code.language-mermaid')].map((c) => c.parentElement),
      ];
      if (blocos.length) {
        const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11.4.1/dist/mermaid.esm.min.mjs');
        const fontes = blocos.map((pre) => {
          const div = document.createElement('div');
          div.className = 'diagram';
          pre.replaceWith(div);
          return { div, src: pre.textContent };
        });
        const desenhar = async () => {
          const r = document.documentElement;
          const escuro = r.dataset.theme
            ? r.dataset.theme === 'dark'
            : matchMedia('(prefers-color-scheme: dark)').matches;
          mermaid.initialize({
            startOnLoad: false,
            theme: escuro ? 'dark' : 'neutral',
            fontFamily: 'IBM Plex Sans, system-ui, sans-serif',
            flowchart: { curve: 'basis', htmlLabels: true },
          });
          for (const [i, f] of fontes.entries()) {
            const { svg } = await mermaid.render(`mmd-${i}-${Date.now()}`, f.src);
            f.div.innerHTML = svg;
          }
        };
        await desenhar();
        document.addEventListener('tema', desenhar);
      }
    </script>
  </body>
</html>

<style>
  .topo {
    position: sticky; top: 0; z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .topo-in { display: flex; align-items: center; justify-content: space-between; gap: 12px; height: 62px; }
  .marca { display: flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; font-weight: 600; }
  .logo {
    display: grid; place-items: center; width: 32px; height: 32px; border-radius: 9px;
    background: var(--accent); color: var(--accent-ink); font: 600 0.8rem/1 var(--mono);
  }
  nav { display: flex; align-items: center; gap: 2px; }
  nav a {
    color: var(--ink-2); text-decoration: none; font-size: 0.93rem;
    padding: 7px 10px; border-radius: 8px;
  }
  nav a:hover { color: var(--ink); background: var(--surface-2); }
  nav a[aria-current='page'] { color: var(--ink); font-weight: 500; background: var(--surface-2); }
  .tema {
    display: grid; place-items: center; width: 34px; height: 34px; margin-left: 4px;
    border: 1px solid var(--line); background: var(--surface); color: var(--ink-2);
    border-radius: 8px; cursor: pointer;
  }
  @media (max-width: 640px) {
    .marca-txt { display: none; }
    nav a { padding: 6px 5px; font-size: 0.82rem; }
    .tema { width: 30px; height: 30px; margin-left: 2px; }
  }
  .rodape { border-top: 1px solid var(--line); margin-top: 64px; padding: 26px 0; font-size: 0.9rem; color: var(--ink-3); }
  .rodape-in { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px 24px; }
  .rodape p { margin: 0; }
  .links { display: flex; gap: 18px; }
</style>
