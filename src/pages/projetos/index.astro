---
import Base from '../../layouts/Base.astro';
import ProjetoCard from '../../components/ProjetoCard.astro';
import { listarProjetos } from '../../data/projetos';

const projetos = await listarProjetos();
---
<Base titulo="Projetos" descricao="Estudos de caso de engenharia de dados, ciência de dados, BI e IA aplicada.">
  <section class="wrap topo-pag">
    <p class="eyebrow">Projetos</p>
    <h1>Estudos de caso</h1>
    <p class="lead">
      Cada projeto conta o problema, a arquitetura, as decisões (e o que foi descartado), como os
      dados foram validados e o resultado.
    </p>
  </section>

  <section class="wrap">
    <div class="grid c3">{projetos.map((p) => (
      <div class="rel">
        {p.data.rascunho && <span class="rascunho">rascunho · só no dev</span>}
        <ProjetoCard projeto={p} />
      </div>
    ))}</div>
  </section>
</Base>

<style>
  .topo-pag { padding-top: 56px; padding-bottom: 32px; }
  .rel { position: relative; display: flex; flex-direction: column; }
  .rel > :global(a) { flex: 1; }
  .rascunho { position: absolute; z-index: 2; top: 10px; right: 10px; background: #c0392b; color: #fff; font: 600 0.72rem/1 var(--mono); padding: 5px 8px; border-radius: 6px; }
</style>
