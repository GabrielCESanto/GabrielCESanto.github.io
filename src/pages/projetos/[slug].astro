---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { areas } from '../../data/perfil';
import { listarProjetos } from '../../data/projetos';

export async function getStaticPaths() {
  const projetos = await listarProjetos();
  return projetos.map((p) => ({ params: { slug: p.id }, props: { projeto: p } }));
}

const { projeto } = Astro.props;
const d = projeto.data;
const area = areas[d.area];
const { Content } = await render(projeto);
---
<Base titulo={d.titulo} descricao={d.resumo}>
  <article class="wrap">
    <header class="cab">
      <a class="voltar" href="/projetos">← Projetos</a>
      <span class="area" style={`color:${area.cor}`}>{area.rotulo}</span>
      <h1>{d.titulo}</h1>
      <p class="lead">{d.resumo}</p>
      <dl class="ficha">
        <div><dt>Papel</dt><dd>{d.papel}</dd></div>
        <div><dt>Período</dt><dd>{d.periodo}</dd></div>
      </dl>
      <div class="tags">{d.stack.map((s) => <span class="tag">{s}</span>)}</div>
      {(d.links.repo || d.links.site) && (
        <div class="acoes">
          {d.links.site && <a class="btn primary" href={d.links.site}>Abrir o site ↗</a>}
          {d.links.repo && <a class="btn" href={d.links.repo}>Código no GitHub ↗</a>}
        </div>
      )}
    </header>

    {d.metricas.length > 0 && (
      <div class="metrics">
        {d.metricas.map((m) => <div class="card metric"><b>{m.valor}</b><span>{m.rotulo}</span></div>)}
      </div>
    )}

    <div class="prose corpo"><Content /></div>
  </article>
</Base>

<style>
  .cab { padding: 40px 0 28px; display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .cab h1 { margin: 0; }
  .cab .lead { margin: 0; }
  .voltar { font-size: 0.9rem; text-decoration: none; color: var(--ink-3); }
  .ficha { display: flex; flex-wrap: wrap; gap: 8px 32px; margin: 4px 0; }
  .ficha dt { font: 500 0.72rem/1 var(--mono); text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-3); margin-bottom: 4px; }
  .ficha dd { margin: 0; }
  .acoes { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
  .corpo { margin-top: 8px; }
</style>
