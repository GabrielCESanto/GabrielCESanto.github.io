---
// Página única: cada seção é um componente em components/secoes/ e o menu do topo leva às âncoras.
// Os estudos de caso continuam em /projetos/<slug>.
import Base from '../layouts/Base.astro';
import Projetos from '../components/secoes/Projetos.astro';
import Dashboards from '../components/secoes/Dashboards.astro';
import Arquitetura from '../components/secoes/Arquitetura.astro';
import Sobre from '../components/secoes/Sobre.astro';
import { perfil } from '../data/perfil';

const numeros = [
  { valor: '20+', rotulo: 'dashboards de Power BI em produção' },
  { valor: '88–95%', rotulo: 'menos tempo nos processos automatizados' },
  { valor: '~10', rotulo: 'fontes integradas em pipeline orquestrado' },
  { valor: '3', rotulo: 'pessoas no time de dados que coordeno' },
];
---
<Base>
  <section id="inicio" class="hero wrap">
    <div class="hero-txt">
      <p class="eyebrow">{perfil.cargo} · {perfil.local}</p>
      <h1>Dados públicos e de negócio, do CSV bruto ao painel no ar.</h1>
      <p class="lead">
        Sou {perfil.nome}, engenheiro de computação pela UTFPR e coordenador de dados no varejo
        farmacêutico. Aqui estão os projetos em que desenhei a arquitetura, escrevi o pipeline e
        publiquei o resultado.
      </p>
      <div class="cta">
        <a class="btn primary" href="#projetos">Ver projetos</a>
        <a class="btn" href="#dashboards">Dashboards</a>
        <a class="btn" href={perfil.links.linkedin}>LinkedIn</a>
      </div>
    </div>
    <img class="foto" src={perfil.foto} alt={`Foto de ${perfil.nomeCurto}`} width="480" height="480" />
  </section>

  <div class="wrap">
    <div class="metrics">
      {numeros.map((n) => <div class="card metric"><b>{n.valor}</b><span>{n.rotulo}</span></div>)}
    </div>
  </div>

  <Projetos />
  <Dashboards />
  <Arquitetura />
  <Sobre />
</Base>

<style>
  .hero { padding: 56px 16px 40px; display: grid; gap: 32px; align-items: center; }
  @media (min-width: 720px) { .hero { padding: 88px 28px 48px; grid-template-columns: 1fr 300px; gap: 48px; } }
  .foto {
    width: 220px; aspect-ratio: 1; object-fit: cover; border-radius: 28px; order: -1;
    border: 1px solid var(--line); box-shadow: 0 12px 40px rgb(0 0 0 / 0.12);
  }
  @media (min-width: 720px) { .foto { width: 100%; order: 0; } }
  .hero h1 { max-width: 22ch; text-wrap: balance; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  /* Linha fina entre as seções da página única */
  :global(main > section.section) { border-top: 1px solid var(--line); margin-top: 40px; }
</style>
