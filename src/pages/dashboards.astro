---
import Base from '../layouts/Base.astro';
import Capa from '../components/Capa.astro';
import { dashboards, paineisWeb } from '../data/dashboards';
---
<Base titulo="Dashboards" descricao="Painéis em Power BI e BIs web próprios, interativos direto na página.">
  <section class="wrap topo-pag">
    <p class="eyebrow">Dashboards</p>
    <h1>Painéis interativos</h1>
    <p class="lead">
      Os painéis em Power BI abaixo são públicos e abrem aqui mesmo. Clique em "Carregar" para
      interagir. Os dos clientes da empresa não estão aqui; os de finanças são adaptações feitas para
      portfólio.
    </p>
  </section>

  <section class="wrap lista">
    {dashboards.map((d) => (
      <article class="card dash" id={d.id}>
        <div class="info">
          <span class="area" style="color:var(--c-bi)">{d.contexto}</span>
          <h2>{d.titulo}</h2>
          <p>{d.descricao}</p>
          <ul>{d.destaques.map((x) => <li>{x}</li>)}</ul>
          <p class="muted ferr">{d.ferramenta}</p>
          <div class="acoes">
            <a class="btn" href={d.url} target="_blank" rel="noopener">Tela cheia ↗</a>
            {d.projeto && <a class="btn" href={`/projetos/${d.projeto}`}>Estudo de caso</a>}
          </div>
        </div>
        <div class="quadro" data-src={d.url} data-titulo={d.titulo}>
          <Capa icones={d.icones} cor="var(--c-bi)" />
          <button class="btn primary carregar" type="button">▶ Carregar dashboard</button>
        </div>
      </article>
    ))}
  </section>

  <section class="section wrap">
    <h2>BIs como aplicação web</h2>
    <p class="lead">
      Quando o painel precisa ser público, gratuito e aguentar milhões de linhas, eu escrevo o BI como
      site: os dados ficam em Parquet e o navegador faz as consultas com DuckDB-WASM.
    </p>
    <div class="lista-web">
      {paineisWeb.map((p) => (
        <a class="card web" href={`/projetos/${p.projeto}`}>
          <Capa icones={p.icones} cor="var(--c-eng)" selo="TCC" />
          <div class="web-in">
            <h3>{p.titulo}</h3>
            <p>{p.descricao}</p>
            <span class="tag">{p.ferramenta}</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>

<script is:inline>
  // Os iframes do Power BI são pesados: só carregam quando a pessoa pede.
  document.querySelectorAll('.quadro').forEach((q) => {
    q.querySelector('.carregar')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = q.dataset.src;
      f.title = q.dataset.titulo;
      f.allowFullscreen = true;
      f.loading = 'lazy';
      q.replaceChildren(f);
      q.classList.add('ativo');
    });
  });
</script>

<style>
  .topo-pag { padding-top: 56px; padding-bottom: 32px; }
  .lista { display: flex; flex-direction: column; gap: 22px; }
  .dash { display: grid; gap: 20px; padding: 20px; scroll-margin-top: 80px; }
  @media (min-width: 900px) { .dash { grid-template-columns: 1fr 1.7fr; padding: 24px; } }
  .info h2 { margin: 8px 0 10px; }
  .info p { color: var(--ink-2); }
  .info ul { margin: 0 0 14px; padding-left: 1.2em; color: var(--ink-2); font-size: 0.95rem; }
  .ferr { font: 0.82rem var(--mono); }
  .acoes { display: flex; flex-wrap: wrap; gap: 8px; }
  .quadro {
    position: relative; aspect-ratio: 16 / 9.6; border-radius: 10px; overflow: hidden;
    background: linear-gradient(135deg, var(--surface-2), var(--accent-soft));
    display: grid; place-items: center; border: 1px solid var(--line);
  }
  .quadro > :global(.capa) { position: absolute; inset: 0; aspect-ratio: auto; }
  .quadro .carregar { position: absolute; left: 50%; bottom: 18px; translate: -50% 0; z-index: 2; }
  .quadro :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .web { overflow: hidden; color: inherit; text-decoration: none; display: grid; }
  @media (min-width: 720px) { .web { grid-template-columns: 1fr 1.3fr; } }
  .web:hover { border-color: var(--ink-3); }
  .web-in { padding: 22px; display: flex; flex-direction: column; gap: 10px; align-items: flex-start; justify-content: center; }
  .web-in h3, .web-in p { margin: 0; }
  .web-in p { color: var(--ink-2); font-size: 0.95rem; }
</style>
